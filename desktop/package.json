{
  "name": "aerotrace-desktop",
  "version": "0.1.0",
  "description": "Offline AE300 engine-health research workspace",
  "author": "AeroTrace Project",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node ../scripts/prepare-cad.cjs && tsc --noEmit && webpack --mode production",
    "start": "electron .",
    "package": "electron-builder --win nsis --x64",
    "test": "node ../scripts/prepare-cad.cjs && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.0.0",
    "echarts": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^6.0.0",
    "ts-loader": "^9.0.0",
    "css-loader": "^7.0.0",
    "style-loader": "^4.0.0",
    "html-webpack-plugin": "^5.0.0",
    "copy-webpack-plugin": "^13.0.0"
  },
  "build": {
    "appId": "org.aerotrace.research",
    "productName": "AeroTrace",
    "directories": {
      "output": "../output/ae300_desktop_v1",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-bundle/aerotrace-server",
        "to": "backend"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "artifactName": "AeroTrace-Setup-${version}-${arch}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
